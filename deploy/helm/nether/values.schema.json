{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Nether's chart values",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "list": { "type": "array" },
    "map": { "type": "object" },
    "quantity": {
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]+)?(Ki|Mi|Gi|Ti|Pi|Ei|k|M|G|T|P|E)?$"
    }
  },
  "properties": {
    "global": { "type": "object" },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "imagePullSecrets": { "$ref": "#/definitions/list" },
    "ha": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "enabled": { "type": "boolean" } }
    },
    "replicaCount": { "type": ["integer", "null"], "minimum": 1 },
    "autoscaling": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "minReplicas": { "type": "integer", "minimum": 1 },
        "maxReplicas": { "type": "integer", "minimum": 1 },
        "targetCPUUtilizationPercentage": { "type": "integer", "minimum": 1, "maximum": 100 }
      }
    },
    "server": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "publicUrl": { "type": "string", "pattern": "^(https?://.+)?$" },
        "trustProxy": { "type": "string" },
        "logLevel": { "enum": ["fatal", "error", "warn", "info", "debug", "trace", "silent"] },
        "drainSeconds": { "type": "integer", "minimum": 0, "maximum": 300 },
        "enterprise": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "sso": { "enum": ["on", "off"] },
            "scim": { "enum": ["on", "off"] },
            "audit": { "enum": ["on", "off"] },
            "policies": { "enum": ["on", "off"] },
            "admin": { "enum": ["on", "off"] }
          }
        }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["disk", "s3"] },
        "disk": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "existingClaim": { "type": "string" },
            "size": { "$ref": "#/definitions/quantity" },
            "storageClassName": { "type": "string" },
            "accessModes": {
              "type": "array",
              "minItems": 1,
              "items": { "enum": ["ReadWriteOnce", "ReadWriteMany", "ReadWriteOncePod"] }
            }
          }
        },
        "s3": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "endpoint": { "type": "string" },
            "bucket": { "type": "string" },
            "region": { "type": "string" }
          }
        }
      }
    },
    "bundled": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "postgres": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "image": { "type": "string" },
            "size": { "$ref": "#/definitions/quantity" },
            "storageClassName": { "type": "string" }
          }
        },
        "valkey": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "image": { "type": "string" } }
        }
      }
    },
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": { "type": "string" },
        "keys": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "databaseUrl": { "type": "string", "minLength": 1 },
            "redisUrl": { "type": "string", "minLength": 1 },
            "secretKey": { "type": "string", "minLength": 1 },
            "setupCode": { "type": "string", "minLength": 1 },
            "s3AccessKey": { "type": "string", "minLength": 1 },
            "s3SecretKey": { "type": "string", "minLength": 1 },
            "smtpUrl": { "type": "string", "minLength": 1 },
            "oidcClientSecret": { "type": "string", "minLength": 1 }
          }
        },
        "databaseUrl": { "type": "string", "pattern": "^(postgres(ql)?://.+)?$" },
        "redisUrl": { "type": "string", "pattern": "^(rediss?://.+)?$" },
        "secretKey": { "type": "string" },
        "setupCode": { "type": "string" },
        "s3AccessKey": { "type": "string" },
        "s3SecretKey": { "type": "string" },
        "smtpUrl": { "type": "string" },
        "oidcClientSecret": { "type": "string" }
      }
    },
    "extraEnv": { "$ref": "#/definitions/list" },
    "extraEnvFrom": { "$ref": "#/definitions/list" },
    "migrations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "job": { "type": "boolean" },
        "backoffLimit": { "type": "integer", "minimum": 0 }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "nodePort": { "type": ["integer", "null"], "minimum": 30000, "maximum": 32767 },
        "annotations": { "$ref": "#/definitions/map" }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "annotations": { "$ref": "#/definitions/map" },
        "hosts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["host"],
            "properties": { "host": { "type": "string", "minLength": 1 } }
          }
        },
        "tls": { "$ref": "#/definitions/list" }
      }
    },
    "httpRoute": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "annotations": { "$ref": "#/definitions/map" },
        "parentRefs": { "$ref": "#/definitions/list" },
        "hostnames": { "type": "array", "items": { "type": "string" } }
      }
    },
    "resources": { "$ref": "#/definitions/map" },
    "terminationGracePeriodSeconds": { "type": "integer", "minimum": 1 },
    "preStopSleepSeconds": { "type": "integer", "minimum": 0 },
    "podAnnotations": { "$ref": "#/definitions/map" },
    "podLabels": { "$ref": "#/definitions/map" },
    "nodeSelector": { "$ref": "#/definitions/map" },
    "tolerations": { "$ref": "#/definitions/list" },
    "affinity": { "$ref": "#/definitions/map" },
    "topologySpread": { "type": "boolean" },
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "enabled": { "type": "boolean" } }
    }
  }
}
