    "@nether/mobile-plugin": "link:./plugin"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "@nether/desktop": "workspace:*",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "vite": "^8.3.5"
  }
