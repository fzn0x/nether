{
  "name": "@nether/desktop",
  "version": "0.2.0",
  "private": true,
  "description": "The Nether desktop app for Windows, macOS and Linux, built with MyGO.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "go tool mygo dev",
    "build": "vite build",
    "build:app": "go tool mygo build",
    "generate": "go tool mygo generate",
    "icon": "node scripts/render-icon.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:go": "go test ./...",
    "test:e2e": "playwright test",
    "perf:ui": "playwright test -c playwright.perf.config.ts ui.spec.ts",
    "perf:graph": "playwright test -c playwright.perf.config.ts graph.spec.ts"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "8.0.1",
