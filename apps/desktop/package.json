    "@capacitor/core": "8.6.2",
    "@capacitor/share": "8.0.3",
    "@capawesome/capacitor-app-shortcuts": "8.0.3",
    "@capawesome/capacitor-background-task": "8.0.3",
    "@mygo-plugins/fetch": "0.10.0",
    "@mygo-plugins/sqlite": "0.10.0",
    "@mygo-plugins/websocket": "0.10.0",
    "@nether/ai": "workspace:*",
    "@nether/automations": "workspace:*",
    "@nether/canvas": "workspace:*",
    "@nether/core": "workspace:*",
