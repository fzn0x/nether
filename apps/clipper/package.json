{
  "name": "@nether/clipper",
  "version": "0.2.0",
  "private": true,
  "description": "The Nether web clipper: a browser extension for Chrome and Firefox that saves a page or a selection as Markdown to a note or a database on your Nether server.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "node scripts/build.ts --test && playwright test",
    "icons": "node scripts/render-icons.ts"
  },
  "dependencies": {
    "@mozilla/readability": "0.6.0",
    "@nether/core": "workspace:*",
    "@nether/markdown": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.19.2",
    "jsdom": "^31.0.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
